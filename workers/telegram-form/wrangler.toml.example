name = "osam-contact-telegram"
main = "index.js"
compatibility_date = "2024-01-01"
workers_dev = true

[vars]
ALLOWED_ORIGINS = "https://osamdesign.com,https://ystas97.github.io,http://127.0.0.1:8766,http://localhost:8080"

# Секреты (не коммитить):
# npx wrangler secret put TELEGRAM_BOT_TOKEN
# npx wrangler secret put TELEGRAM_CHAT_ID
# Необязательно: отклики Career в отдельный чат (иначе уйдут в TELEGRAM_CHAT_ID)
# npx wrangler secret put TELEGRAM_CAREER_CHAT_ID
# Если это группа с темами (topics) — id темы:
# npx wrangler secret put TELEGRAM_CAREER_THREAD_ID
